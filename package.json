{
    "name": "visual-builder-4",
    "displayName": "Visual Builder 4",
    "description": "Extension that replaces the editor Sanny builder 4",
    "version": "0.0.1",
    "publisher": "eos-mixel",
    "author": "EOS, Mixel",
    "license": "MIT",
    "icon": "images/marketplace-icon.png",
    "galleryBanner": {
        "color": "#100f11",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.108.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/NoPressF/sb4-vscode"
    },
    "bugs": {
        "url": "https://github.com/NoPressF/sb4-vscode/issues"
    },
    "categories": [
        "Other",
        "Formatters"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onFileSystem:sb4-tab"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "sb4.selectFolder",
                "title": "%command.selectFolder%"
            },
            {
                "command": "sb4.selectVersion",
                "title": "%command.selectVersion%"
            },
            {
                "command": "sb4.compileScript",
                "title": "%command.compileScript%"
            },
            {
                "command": "sb4.decompileScript",
                "title": "%command.decompileScript%"
            },
            {
                "command": "sb4.searchOpcodes",
                "title": "%command.searchOpcodes%"
            },
            {
                "command": "sb4.reloadColors",
                "title": "%command.reloadColors%"
            },
            {
                "command": "sb4.customizeColors",
                "title": "%command.customizeColors%"
            },
            {
                "command": "sb4.customizeFontStyles",
                "title": "%command.customizeFontStyles%"
            },
            {
                "command": "sb4.importTheme",
                "title": "%command.importTheme%"
            },
            {
                "command": "sb4.themeCreator",
                "title": "%command.themeCreator%"
            },
            {
                "command": "sb4.insertCoordinates",
                "title": "%command.insertCoordinates%"
            },
            {
                "command": "sb4.insertAngle",
                "title": "%command.insertAngle%"
            },
            {
                "command": "sb4.openGame",
                "title": "%command.openGame%"
            },
            {
                "command": "sb4.selectGameFolder",
                "title": "%command.selectGameFolder%"
            },
            {
                "command": "sb4.buildVsix",
                "title": "%command.buildVsix%"
            },
            {
                "command": "sb4.selectLanguage",
                "title": "%command.selectLanguage%"
            },
            {
                "command": "sb4.exportTexts",
                "title": "%command.exportTexts%"
            },
            {
                "command": "sb4.importTexts",
                "title": "%command.importTexts%"
            }
        ],
"configuration": {
            "title": "%config.title%",
            "properties": {
                "sb4.language": {
                    "type": "string",
                    "default": "en",
                    "description": "%config.language%"
                },
                "sb4.openGame.quickLoad": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.openGameQuickLoad%"
                },
                "sb4.colors.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.colorsEnabled%"
                },
                "sb4.colors.iniPath": {
                    "type": "string",
                    "default": "",
                    "description": "%config.colorsIniPath%"
                },
                "sb4.coords.coordinateDecimals": {
                    "type": "number",
                    "default": 4,
                    "description": "%config.coordinateDecimals%"
                },
                "sb4.coords.angleDecimals": {
                    "type": "number",
                    "default": 2,
                    "description": "%config.angleDecimals%"
                },
                "sb4.coords.processOverrides": {
                    "type": "object",
                    "default": {},
                    "description": "%config.processOverrides%",
                    "properties": {
                        "gta_sa": {
                            "type": "object",
                            "properties": {
                                "playerPointer": {
                                    "type": "string"
                                },
                                "angleOffset": {
                                    "type": "string"
                                }
                            }
                        },
                        "gta-vc": {
                            "type": "object",
                            "properties": {
                                "playerPointer": {
                                    "type": "string"
                                },
                                "angleOffset": {
                                    "type": "string"
                                }
                            }
                        },
                        "gta3": {
                            "type": "object",
                            "properties": {
                                "playerPointer": {
                                    "type": "string"
                                },
                                "angleOffset": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "keybindings": [
            {
                "key": "f6",
                "command": "sb4.compileScript",
                "when": "editorTextFocus"
            },
            {
                "key": "f7",
                "command": "sb4.decompileScript",
                "when": "editorTextFocus"
            },
            {
                "key": "ctrl+alt+2",
                "command": "sb4.searchOpcodes",
                "when": "editorTextFocus"
            },
            {
                "key": "ctrl+shift+c",
                "command": "sb4.insertCoordinates",
                "when": "editorTextFocus \u0026\u0026 resourceLangId == sannybuilder"
            },
            {
                "key": "ctrl+shift+e",
                "command": "sb4.insertAngle",
                "when": "editorTextFocus \u0026\u0026 resourceLangId == sannybuilder"
            },
            {
                "key": "f8",
                "command": "sb4.openGame"
            },
            {
                "key": "f9",
                "command": "sb4.buildVsix"
            }
        ],
        "languages": [
            {
                "id": "sannybuilder",
                "aliases": [
                    "Sanny Builder",
                    "SannyBuilder",
                    "SB"
                ],
                "extensions": [
                    ".sb",
                    ".scm",
                    ".cs",
                    ".cs3",
                    ".cs4",
                    ".s",
                    ".cm",
                    ".csa",
                    ".csi"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./images/language-icon-16.png",
                    "dark": "./images/language-icon-16.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "sannybuilder",
                "scopeName": "source.sb4",
                "path": "./syntax/sb4.tm-language.json",
                "extensions": [
                    ".sb",
                    ".scm",
                    ".cs",
                    ".cs3",
                    ".cs4",
                    ".s",
                    ".cm",
                    ".csa",
                    ".csi"
                ]
            }
        ],
        "snippets": [
            {
                "language": "sannybuilder",
                "path": "./snippets/snippets.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "sannybuilder",
                "scopes": {
                    "class": [
                        "class.sb"
                    ],
                    "method": [
                        "method.sb"
                    ]
                }
            }
        ]
    },
    "keywords": [
        "sanny builder 4",
        "sanny builder",
        "scm",
        "gta",
        "cleo"
    ],
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p tsconfig.json \u0026\u0026 tsc-alias -p tsconfig.json",
        "watch": "tsc -watch -p tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^20.19.28",
        "@types/vscode": "^1.108.1",
        "@typescript-eslint/eslint-plugin": "^8.52.0",
        "@typescript-eslint/parser": "^8.52.0",
        "eslint": "^9.39.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "tsc-alias": "^1.8.16",
        "iconv-lite": "^0.7.2",
        "fast-xml-parser": "^5.3.3"
    }
}